---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

const freight = [
  {
    icon: "✈️",
    title: "Air Freight",
    sub: "Fast. Reliable. Global.",
    desc: "Time-critical shipments handled with precision — door-to-door air cargo with real-time tracking at every step.",
    tag: "Express",
    accentBg: "bg-sky-600",
    accentLight: "bg-sky-50",
    accentText: "text-sky-600",
    accentBorder: "border-sky-200",
    tagBg: "bg-sky-100 text-sky-700",
    btnCls: "bg-sky-600 hover:bg-sky-500",
    headerFrom: "from-sky-400", headerTo: "to-blue-700",
    checkCls: "text-sky-600 bg-sky-100",
    features: ["Express & standard cargo","Door-to-door delivery","Real-time tracking","Customs included","Temp-sensitive handling","Dangerous goods"],
  },
  {
    icon: "🚢",
    title: "Sea Freight",
    sub: "Cost-Effective. Scalable.",
    desc: "Move large volumes economically with FCL & LCL ocean freight — expert port handling and documentation included.",
    tag: "Economy",
    accentBg: "bg-teal-600",
    accentLight: "bg-teal-50",
    accentText: "text-teal-600",
    accentBorder: "border-teal-200",
    tagBg: "bg-teal-100 text-teal-700",
    btnCls: "bg-teal-600 hover:bg-teal-500",
    headerFrom: "from-cyan-400", headerTo: "to-teal-700",
    checkCls: "text-teal-600 bg-teal-100",
    features: ["Full Container (FCL)","Less Container (LCL)","Port-to-port","Door-to-door","Import/export docs","Reefer containers"],
  },
  {
    icon: "🚛",
    title: "Road Freight",
    sub: "Domestic. Dependable. On-Time.",
    desc: "FTL and LTL options across Bangladesh — GPS-tracked fleet with digital proof of delivery every time.",
    tag: "Domestic",
    accentBg: "bg-orange-600",
    accentLight: "bg-orange-50",
    accentText: "text-orange-600",
    accentBorder: "border-orange-200",
    tagBg: "bg-orange-100 text-orange-700",
    btnCls: "bg-orange-500 hover:bg-orange-400",
    headerFrom: "from-orange-400", headerTo: "to-red-600",
    checkCls: "text-orange-600 bg-orange-100",
    features: ["Full Truckload (FTL)","LTL available","GPS-tracked fleet","Same-day pickup","Digital POD","Inter-district"],
  },
];

const logistics = [
  {
    icon: "🏭",
    title: "Warehousing",
    sub: "Secure. Smart. Same-Day Ready.",
    desc: "Dhaka-based storage with real-time inventory management. Scale up or down — no long-term contracts required.",
    tag: "Storage",
    accentBg: "bg-violet-600",
    accentLight: "bg-violet-50",
    accentText: "text-violet-600",
    accentBorder: "border-violet-200",
    tagBg: "bg-violet-100 text-violet-700",
    btnCls: "bg-violet-600 hover:bg-violet-500",
    headerFrom: "from-violet-500", headerTo: "to-purple-700",
    checkCls: "text-violet-600 bg-violet-100",
    features: ["Climate-controlled","Real-time inventory","Same-day dispatch","CCTV & security","Flexible plans","Pick & pack"],
  },
  {
    icon: "📦",
    title: "Last-Mile Delivery",
    sub: "Fast. Tracked. To the Door.",
    desc: "Live SMS updates and digital proof of delivery on every order — your customers always stay informed.",
    tag: "Consumer",
    accentBg: "bg-emerald-600",
    accentLight: "bg-emerald-50",
    accentText: "text-emerald-600",
    accentBorder: "border-emerald-200",
    tagBg: "bg-emerald-100 text-emerald-700",
    btnCls: "bg-emerald-600 hover:bg-emerald-500",
    headerFrom: "from-emerald-400", headerTo: "to-green-700",
    checkCls: "text-emerald-600 bg-emerald-100",
    features: ["Doorstep delivery","Live SMS updates","Digital POD","Re-attempt on fail","E-commerce ready","Cash on delivery"],
  },
];

const valueAdded = [
  {
    icon: "📋",
    title: "Customs Clearance",
    sub: "Compliant. Fast. Stress-Free.",
    desc: "We handle all documentation, HS classification, and authority liaison so your imports and exports move without friction.",
    tag: "Compliance",
    accentBg: "bg-rose-600",
    accentLight: "bg-rose-50",
    accentText: "text-rose-600",
    accentBorder: "border-rose-200",
    tagBg: "bg-rose-100 text-rose-700",
    btnCls: "bg-rose-600 hover:bg-rose-500",
    headerFrom: "from-rose-500", headerTo: "to-red-700",
    checkCls: "text-rose-600 bg-rose-100",
    features: ["Import & export clearance","HS code classification","Document preparation","Authority liaison","Duty & tax advisory","Compliance consulting"],
  },
  {
    icon: "🔗",
    title: "Supply Chain",
    sub: "Visibility. Control. Optimised.",
    desc: "End-to-end supply chain management — from vendor coordination to final delivery, every handover point monitored.",
    tag: "Advisory",
    accentBg: "bg-amber-500",
    accentLight: "bg-amber-50",
    accentText: "text-amber-600",
    accentBorder: "border-amber-200",
    tagBg: "bg-amber-100 text-amber-700",
    btnCls: "bg-amber-500 hover:bg-amber-400",
    headerFrom: "from-amber-400", headerTo: "to-orange-600",
    checkCls: "text-amber-600 bg-amber-100",
    features: ["End-to-end coordination","Vendor management","Route optimization","Cost reduction","Performance reports","Dedicated manager"],
  },
];
---

<Layout title="Services — Tipu Logistics" description="Complete logistics solutions — air, sea, road freight, warehousing, last-mile delivery and customs clearance across Bangladesh.">

  <!-- ═══ HERO ═══ -->
  <section class="relative bg-[#040d1f] overflow-hidden">
    <div class="absolute inset-0 opacity-[0.12]" style="background-image:linear-gradient(rgba(14,165,233,0.5) 1px,transparent 1px),linear-gradient(90deg,rgba(14,165,233,0.5) 1px,transparent 1px);background-size:40px 40px;"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-blue-600/25 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="relative max-w-4xl mx-auto px-4 pt-14 pb-12 sm:pt-20 sm:pb-16 text-center">
      <div class="inline-flex items-center gap-2 bg-blue-500/15 border border-blue-500/30 text-blue-400 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
        What We Offer
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-[1.06] mb-4">
        Complete Logistics<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-blue-400">Solutions</span>
      </h1>
      <p class="text-gray-400 text-base sm:text-lg max-w-lg mx-auto mb-8 leading-relaxed">
        From a single parcel to your entire supply chain — handled with care, across Bangladesh and beyond.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-blue-600 to-blue-500 text-white font-bold px-7 py-4 rounded-2xl text-sm shadow-xl shadow-blue-900/50 active:scale-95 transition-transform">
          Get a Free Quote →
        </a>
        <a href="#services-list" class="inline-flex items-center justify-center gap-2 bg-white/10 border border-white/20 text-white font-semibold px-7 py-4 rounded-2xl text-sm active:scale-95 transition-transform backdrop-blur-sm">
          Browse Services ↓
        </a>
      </div>
    </div>
    <!-- Service chips row -->
    <div class="relative flex flex-wrap justify-center gap-2 px-4 pb-12">
      {["✈️ Air Freight","🚢 Sea Freight","🚛 Road Freight","🏭 Warehousing","📦 Last-Mile","📋 Customs","🔗 Supply Chain"].map(s => (
        <span class="bg-white/8 border border-white/15 text-gray-300 text-xs font-medium px-3.5 py-2 rounded-full">{s}</span>
      ))}
    </div>
    <svg viewBox="0 0 1440 60" fill="none" class="w-full block -mb-px"><path d="M0 60L360 20L720 40L1080 10L1440 30V60H0Z" fill="#f9fafb"/></svg>
  </section>

  <!-- ═══ STICKY FILTER TABS ═══ -->
  <div class="sticky top-14 sm:top-16 z-30 bg-gray-50/95 backdrop-blur border-b border-gray-200 shadow-sm" id="services-list">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex gap-1.5 py-2.5 overflow-x-auto" style="scrollbar-width:none;-webkit-overflow-scrolling:touch;">
        <button data-cat="all"        class="cat-btn flex-none px-4 py-2 rounded-xl text-sm font-bold whitespace-nowrap transition-all bg-[#040d1f] text-white shadow-sm">All Services</button>
        <button data-cat="freight"    class="cat-btn flex-none px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all text-gray-500 hover:bg-white hover:shadow-sm">✈️ Freight</button>
        <button data-cat="logistics"  class="cat-btn flex-none px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all text-gray-500 hover:bg-white hover:shadow-sm">🏭 Logistics</button>
        <button data-cat="valueadded" class="cat-btn flex-none px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all text-gray-500 hover:bg-white hover:shadow-sm">⚙️ Value-Added</button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════ -->
  <!-- SECTION 1: FREIGHT — light gray bg  -->
  <!-- ═══════════════════════════════════ -->
  <section class="cat-section bg-gray-50 py-12 sm:py-16" data-section="freight">
    <div class="max-w-7xl mx-auto px-4">

      <!-- Section label banner -->
      <div class="flex items-center gap-3 mb-8">
        <div class="flex items-center gap-2.5 bg-sky-600 text-white px-4 py-2 rounded-2xl shadow-lg shadow-sky-200">
          <span class="text-lg">✈️</span>
          <span class="font-black text-sm uppercase tracking-wider">Freight</span>
          <span class="bg-white/20 text-white text-xs font-bold px-2 py-0.5 rounded-full">01</span>
        </div>
        <div class="h-px flex-1 bg-gradient-to-r from-sky-200 to-transparent"></div>
      </div>

      <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black text-gray-900 mb-1">Move Cargo by Air, Sea & Road</h2>
      <p class="text-gray-500 text-sm sm:text-base mb-8 max-w-xl">International and domestic shipping solutions — tailored to your timeline and budget.</p>

      <!-- Mobile: full-width stacked cards -->
      <div class="space-y-4 sm:hidden">
        {freight.map(({ icon, title, sub, desc, tag, tagBg, accentBg, accentText, accentLight, accentBorder, btnCls, checkCls, features }) => (
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
            <!-- Mobile horizontal header -->
            <div class={`flex items-center gap-4 px-4 py-4 ${accentLight} border-b ${accentBorder}`}>
              <div class={`w-14 h-14 ${accentBg} rounded-2xl flex items-center justify-center text-3xl shadow-lg shrink-0`}>{icon}</div>
              <div class="min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                  <h3 class="font-display font-black text-lg text-gray-900">{title}</h3>
                  <span class={`text-xs font-bold px-2 py-0.5 rounded-full shrink-0 ${tagBg}`}>{tag}</span>
                </div>
                <p class={`text-xs font-bold uppercase tracking-wide ${accentText}`}>{sub}</p>
              </div>
            </div>
            <div class="p-4">
              <p class="text-gray-500 text-sm leading-relaxed mb-4">{desc}</p>
              <ul class="grid grid-cols-2 gap-y-2 gap-x-3 mb-4">
                {features.map(f => (
                  <li class="flex items-center gap-1.5 text-xs text-gray-700">
                    <span class={`w-4 h-4 rounded-full ${checkCls} flex items-center justify-center shrink-0`}>
                      <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7"/></svg>
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
              <a href="/contact" class={`flex items-center justify-center gap-2 w-full py-3.5 rounded-xl text-sm font-bold text-white ${btnCls} active:scale-95 transition-all shadow-sm`}>
                Get a Quote →
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Desktop: 3-col grid with gradient header cards -->
      <div class="hidden sm:grid grid-cols-2 lg:grid-cols-3 gap-5">
        {freight.map(({ icon, title, sub, desc, tag, tagBg, headerFrom, headerTo, btnCls, checkCls, features }) => (
          <div class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col border border-gray-100">
            <div class={`relative h-40 bg-gradient-to-br ${headerFrom} ${headerTo} flex items-center justify-center overflow-hidden`}>
              <div class="absolute inset-0 opacity-20" style="background-image:radial-gradient(circle, white 1px, transparent 1px);background-size:18px 18px;"></div>
              <span class="text-7xl drop-shadow-xl relative z-10 group-hover:scale-110 transition-transform duration-300">{icon}</span>
              <span class={`absolute top-3 right-3 text-xs font-bold px-2.5 py-1 rounded-full ${tagBg}`}>{tag}</span>
            </div>
            <div class="p-5 flex flex-col flex-1">
              <h3 class="font-display font-black text-xl text-gray-900">{title}</h3>
              <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mt-0.5 mb-3">{sub}</p>
              <p class="text-gray-500 text-sm leading-relaxed mb-4">{desc}</p>
              <ul class="grid grid-cols-2 gap-y-2 gap-x-2 mb-5 flex-1">
                {features.map(f => (
                  <li class="flex items-center gap-1.5 text-xs text-gray-700">
                    <span class={`w-4 h-4 rounded-full ${checkCls} flex items-center justify-center shrink-0`}>
                      <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7"/></svg>
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
              <a href="/contact" class={`flex items-center justify-center gap-2 w-full py-3.5 rounded-2xl text-sm font-bold text-white ${btnCls} active:scale-95 transition-all shadow-md`}>
                Get a Quote →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ DIVIDER: gray → dark ═══ -->
  <div class="relative bg-gray-50">
    <svg viewBox="0 0 1440 56" fill="none" class="w-full block"><path d="M0 0L480 40L960 10L1440 50V56H0Z" fill="#040d1f"/></svg>
  </div>

  <!-- ═══════════════════════════════════════ -->
  <!-- TRUST STRIP — dark navy bg            -->
  <!-- ═══════════════════════════════════════ -->
  <section class="bg-[#040d1f] py-8 sm:py-10">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        {[
          { icon:"⚡", title:"100% On-Time", desc:"Every shipment, every time", color:"text-yellow-400", bg:"bg-yellow-400/10 border-yellow-400/20" },
          { icon:"📍", title:"Live Tracking", desc:"Real-time GPS visibility", color:"text-blue-400", bg:"bg-blue-400/10 border-blue-400/20" },
          { icon:"🔒", title:"No Hidden Fees", desc:"Transparent pricing always", color:"text-green-400", bg:"bg-green-400/10 border-green-400/20" },
          { icon:"📞", title:"24/7 Support", desc:"Always here when you need us", color:"text-purple-400", bg:"bg-purple-400/10 border-purple-400/20" },
        ].map(({ icon, title, desc, color, bg }) => (
          <div class={`rounded-2xl p-4 text-center border ${bg}`}>
            <span class={`text-2xl block mb-2 ${color}`}>{icon}</span>
            <p class="font-bold text-sm text-white">{title}</p>
            <p class="text-xs text-gray-400 mt-0.5 leading-tight">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ DIVIDER: dark → white ═══ -->
  <div class="relative bg-[#040d1f]">
    <svg viewBox="0 0 1440 56" fill="none" class="w-full block"><path d="M0 56L360 20L720 45L1080 15L1440 40V56H0Z" fill="white"/></svg>
  </div>

  <!-- ═══════════════════════════════════════ -->
  <!-- SECTION 2: LOGISTICS — white bg        -->
  <!-- ═══════════════════════════════════════ -->
  <section class="cat-section bg-white py-12 sm:py-16" data-section="logistics">
    <div class="max-w-7xl mx-auto px-4">

      <div class="flex items-center gap-3 mb-8">
        <div class="flex items-center gap-2.5 bg-violet-600 text-white px-4 py-2 rounded-2xl shadow-lg shadow-violet-200">
          <span class="text-lg">🏭</span>
          <span class="font-black text-sm uppercase tracking-wider">Logistics</span>
          <span class="bg-white/20 text-white text-xs font-bold px-2 py-0.5 rounded-full">02</span>
        </div>
        <div class="h-px flex-1 bg-gradient-to-r from-violet-200 to-transparent"></div>
      </div>

      <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black text-gray-900 mb-1">Storage, Fulfilment & Delivery</h2>
      <p class="text-gray-500 text-sm sm:text-base mb-8 max-w-xl">End-to-end logistics operations from our Dhaka hub — straight to your customer's door.</p>

      <!-- Mobile cards -->
      <div class="space-y-4 sm:hidden">
        {logistics.map(({ icon, title, sub, desc, tag, tagBg, accentBg, accentText, accentLight, accentBorder, btnCls, checkCls, features }) => (
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
            <div class={`flex items-center gap-4 px-4 py-4 ${accentLight} border-b ${accentBorder}`}>
              <div class={`w-14 h-14 ${accentBg} rounded-2xl flex items-center justify-center text-3xl shadow-lg shrink-0`}>{icon}</div>
              <div class="min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                  <h3 class="font-display font-black text-lg text-gray-900">{title}</h3>
                  <span class={`text-xs font-bold px-2 py-0.5 rounded-full shrink-0 ${tagBg}`}>{tag}</span>
                </div>
                <p class={`text-xs font-bold uppercase tracking-wide ${accentText}`}>{sub}</p>
              </div>
            </div>
            <div class="p-4">
              <p class="text-gray-500 text-sm leading-relaxed mb-4">{desc}</p>
              <ul class="grid grid-cols-2 gap-y-2 gap-x-3 mb-4">
                {features.map(f => (
                  <li class="flex items-center gap-1.5 text-xs text-gray-700">
                    <span class={`w-4 h-4 rounded-full ${checkCls} flex items-center justify-center shrink-0`}>
                      <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7"/></svg>
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
              <a href="/contact" class={`flex items-center justify-center gap-2 w-full py-3.5 rounded-xl text-sm font-bold text-white ${btnCls} active:scale-95 transition-all shadow-sm`}>
                Get a Quote →
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Desktop grid -->
      <div class="hidden sm:grid grid-cols-2 gap-6">
        {logistics.map(({ icon, title, sub, desc, tag, tagBg, headerFrom, headerTo, btnCls, checkCls, features }) => (
          <div class="group bg-white rounded-3xl overflow-hidden shadow-md hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col border border-gray-100">
            <div class={`relative h-44 bg-gradient-to-br ${headerFrom} ${headerTo} flex items-center justify-center overflow-hidden`}>
              <div class="absolute inset-0 opacity-20" style="background-image:radial-gradient(circle, white 1px, transparent 1px);background-size:18px 18px;"></div>
              <span class="text-8xl drop-shadow-xl relative z-10 group-hover:scale-110 transition-transform duration-300">{icon}</span>
              <span class={`absolute top-3 right-3 text-xs font-bold px-2.5 py-1 rounded-full ${tagBg}`}>{tag}</span>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="font-display font-black text-xl text-gray-900">{title}</h3>
              <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mt-0.5 mb-3">{sub}</p>
              <p class="text-gray-500 text-sm leading-relaxed mb-4">{desc}</p>
              <ul class="grid grid-cols-2 gap-y-2 gap-x-2 mb-5 flex-1">
                {features.map(f => (
                  <li class="flex items-center gap-1.5 text-xs text-gray-700">
                    <span class={`w-4 h-4 rounded-full ${checkCls} flex items-center justify-center shrink-0`}>
                      <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7"/></svg>
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
              <a href="/contact" class={`flex items-center justify-center gap-2 w-full py-3.5 rounded-2xl text-sm font-bold text-white ${btnCls} active:scale-95 transition-all shadow-md`}>
                Get a Quote →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ DIVIDER: white → light blue ═══ -->
  <div class="relative bg-white">
    <svg viewBox="0 0 1440 56" fill="none" class="w-full block"><path d="M0 30L480 56L960 20L1440 45V56H0Z" fill="#eff6ff"/></svg>
  </div>

  <!-- ═══════════════════════════════════════ -->
  <!-- SECTION 3: VALUE-ADDED — blue-50 bg   -->
  <!-- ═══════════════════════════════════════ -->
  <section class="cat-section bg-blue-50 py-12 sm:py-16" data-section="valueadded">
    <div class="max-w-7xl mx-auto px-4">

      <div class="flex items-center gap-3 mb-8">
        <div class="flex items-center gap-2.5 bg-rose-600 text-white px-4 py-2 rounded-2xl shadow-lg shadow-rose-200">
          <span class="text-lg">⚙️</span>
          <span class="font-black text-sm uppercase tracking-wider">Value-Added</span>
          <span class="bg-white/20 text-white text-xs font-bold px-2 py-0.5 rounded-full">03</span>
        </div>
        <div class="h-px flex-1 bg-gradient-to-r from-rose-200 to-transparent"></div>
      </div>

      <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black text-gray-900 mb-1">Customs, Compliance & Strategy</h2>
      <p class="text-gray-500 text-sm sm:text-base mb-8 max-w-xl">Expert support for navigating regulations and optimising your entire supply chain.</p>

      <!-- Mobile cards -->
      <div class="space-y-4 sm:hidden">
        {valueAdded.map(({ icon, title, sub, desc, tag, tagBg, accentBg, accentText, accentLight, accentBorder, btnCls, checkCls, features }) => (
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
            <div class={`flex items-center gap-4 px-4 py-4 ${accentLight} border-b ${accentBorder}`}>
