<script>
  const btns = document.querySelectorAll('.cat-btn');
  const sections = document.querySelectorAll('.cat-section');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = (btn as HTMLElement).getAttribute('data-cat');

      btns.forEach(b => {
        b.classList.remove('bg-blue-600','text-white');
        b.classList.add('text-gray-600','hover:bg-gray-50');
      });
      btn.classList.add('bg-blue-600','text-white');
      btn.classList.remove('text-gray-600','hover:bg-gray-50');

      if (cat === 'all') {
        sections.forEach(s => (s as HTMLElement).style.display = '');
      } else {
        sections.forEach(s => {
          const el = s as HTMLElement;
          el.style.display = el.getAttribute('data-section') === cat ? '' : 'none';
        });
      }

      document.getElementById('services-list')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
