---
---

<section class="relative bg-[#040d1f] overflow-hidden">
  <!-- Grid bg -->
  <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(rgba(14,165,233,0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(14,165,233,0.15) 1px, transparent 1px); background-size: 50px 50px;"></div>
  <!-- Glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-2xl h-72 bg-blue-600/25 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="relative px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto pt-10 pb-0 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">

      <!-- Content -->
      <div class="text-center lg:text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold uppercase tracking-wider px-3 py-1.5 rounded-full mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
          Bangladesh's Trusted Logistics
        </div>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-[1.08] mb-4">
          Moving Your<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">Business</span>
          <br/>Forward
        </h1>

        <p class="text-gray-400 text-base sm:text-lg leading-relaxed mb-7 max-w-lg mx-auto lg:mx-0">
          End-to-end freight, customs clearance & last-mile delivery — connecting you across Bangladesh and beyond.
        </p>

        <!-- CTAs — full width on mobile -->
        <div class="flex flex-col sm:flex-row gap-3 mb-8">
          <a href="/contact" class="flex items-center justify-center gap-2 bg-gradient-to-r from-blue-600 to-blue-500 text-white font-bold px-6 py-4 rounded-xl text-sm shadow-lg shadow-blue-900/50 active:scale-[0.98] transition-transform">
            Get a Free Quote
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="/track" class="flex items-center justify-center gap-2 border border-white/20 text-white font-semibold px-6 py-4 rounded-xl text-sm active:scale-[0.98] transition-transform">
            📍 Track Shipment
          </a>
        </div>

        <!-- Quick track on mobile -->
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4 backdrop-blur-sm mb-8 lg:mb-0">
          <p class="text-white text-xs font-semibold mb-2.5">🔍 Quick Track</p>
          <div class="flex gap-2">
            <input
              type="text"
              placeholder="Enter tracking number..."
              class="flex-1 min-w-0 bg-white/10 border border-white/20 text-white placeholder-gray-500 text-sm px-3 py-3 rounded-lg focus:outline-none focus:border-blue-400"
            />
            <button class="bg-blue-600 text-white text-sm font-bold px-4 py-3 rounded-lg active:scale-95 transition-transform whitespace-nowrap">
              Track
            </button>
          </div>
        </div>
      </div>

      <!-- Stats grid — hidden on mobile to keep hero tight, shown on lg -->
      <div class="hidden lg:grid grid-cols-2 gap-4">
        {[
          { value: "120+", label: "Shipments Delivered", icon: "📦", color: "from-blue-600/20 to-blue-700/10 border-blue-500/20" },
          { value: "3", label: "Countries Covered", icon: "🌍", color: "from-cyan-600/20 to-cyan-700/10 border-cyan-500/20" },
          { value: "100%", label: "On-Time Rate", icon: "⚡", color: "from-orange-500/20 to-orange-600/10 border-orange-500/20" },
          { value: "10", label: "Happy Clients", icon: "🤝", color: "from-purple-600/20 to-purple-700/10 border-purple-500/20" },
        ].map(({ value, label, icon, color }) => (
          <div class={`bg-gradient-to-br ${color} border rounded-2xl p-6 backdrop-blur-sm`}>
            <div class="text-3xl mb-3">{icon}</div>
            <div class="text-3xl font-black text-white mb-1">{value}</div>
            <div class="text-gray-400 text-xs">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Stats scroll row — mobile only -->
  <div class="lg:hidden px-4 pb-0 mt-2">
    <div class="flex gap-3 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-none" style="-webkit-overflow-scrolling: touch;">
      {[
        { value: "120+", label: "Shipments", icon: "📦" },
        { value: "3", label: "Countries", icon: "🌍" },
        { value: "100%", label: "On-Time", icon: "⚡" },
        { value: "10", label: "Clients", icon: "🤝" },
      ].map(({ value, label, icon }) => (
        <div class="flex-none snap-start bg-white/8 border border-white/10 rounded-2xl px-5 py-4 text-center min-w-[110px]">
          <div class="text-2xl mb-1">{icon}</div>
          <div class="text-xl font-black text-white">{value}</div>
          <div class="text-gray-400 text-xs mt-0.5">{label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Wave -->
  <div class="relative">
    <svg viewBox="0 0 1440 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full block">
      <path d="M0 48L60 42C120 36 240 24 360 20C480 16 600 20 720 26C840 32 960 40 1080 40C1200 40 1320 32 1380 28L1440 24V48H0Z" fill="white"/>
    </svg>
  </div>
</section>

<style>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
  .bg-white\/8 { background-color: rgb(255 255 255 / 0.08); }
</style>
