---
const year = new Date().getFullYear();
---

<!-- Extra bottom padding on mobile for sticky bar -->
<div class="h-16 lg:hidden"></div>

<footer class="bg-[#040d1f] text-gray-400">

  <!-- CTA strip -->
  <div class="border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
      <div>
        <p class="text-white font-semibold text-sm sm:text-base">Stay updated with Tipu</p>
        <p class="text-xs sm:text-sm text-gray-500">Logistics news, tips, and offers.</p>
      </div>
      <div class="flex gap-2">
        <input type="email" placeholder="Your email address" class="flex-1 sm:w-56 bg-white/5 border border-white/10 text-white placeholder-gray-600 text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-blue-500"/>
        <button class="bg-blue-600 hover:bg-blue-500 active:scale-95 text-white text-sm font-bold px-5 py-3 rounded-xl transition-all whitespace-nowrap">Subscribe</button>
      </div>
    </div>
  </div>

  <!-- Contact strip (mobile-prominent) -->
  <div class="border-b border-white/10 bg-white/3">
    <div class="max-w-7xl mx-auto px-4 py-5 grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
      <a href="tel:+8801959395939" class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-xl px-4 py-3 active:scale-95 transition-transform">
        <span class="w-9 h-9 bg-green-500/20 border border-green-500/30 rounded-lg flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </span>
        <div>
          <p class="text-white font-semibold text-sm">Call Us</p>
          <p class="text-gray-400 text-xs">01959395939</p>
        </div>
      </a>
      <a href="mailto:info@tipu.com" class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-xl px-4 py-3 active:scale-95 transition-transform">
        <span class="w-9 h-9 bg-blue-500/20 border border-blue-500/30 rounded-lg flex items-center justify-center shrink-0 text-blue-400 text-base">✉️</span>
        <div>
          <p class="text-white font-semibold text-sm">Email Us</p>
          <p class="text-gray-400 text-xs">info@tipu.com</p>
        </div>
      </a>
      <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-xl px-4 py-3">
        <span class="w-9 h-9 bg-purple-500/20 border border-purple-500/30 rounded-lg flex items-center justify-center shrink-0 text-base">📍</span>
        <div>
          <p class="text-white font-semibold text-sm">Location</p>
          <p class="text-gray-400 text-xs">Dhaka, Bangladesh</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Main footer links -->
  <div class="max-w-7xl mx-auto px-4 py-8 sm:py-12">

    <!-- Brand -->
    <div class="flex items-center justify-between mb-6 sm:mb-10">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-blue-800 rounded-lg flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 2h10l2-2z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 16V8h3l2 4v4h-2"/>
          </svg>
        </div>
        <span class="text-white font-bold text-xl">Tipu<span class="text-blue-400">.</span></span>
      </div>
      <!-- Social icons -->
      <div class="flex gap-2">
        {[
          { label: "WhatsApp", href: "https://wa.me/8801959395939", icon: "💬" },
          { label: "Facebook", href: "#", icon: "f" },
          { label: "LinkedIn", href: "#", icon: "in" },
        ].map(({ icon, href, label }) => (
          <a href={href} target="_blank" rel="noopener" aria-label={label} class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 hover:bg-blue-600/30 active:scale-95 flex items-center justify-center text-xs font-bold text-gray-300 transition-all">
            {icon}
          </a>
        ))}
      </div>
    </div>

    <!-- Accordion links on mobile, grid on desktop -->
    <div class="block sm:hidden space-y-2" id="footer-accordion">
      {[
        { title: "Services", links: [["Air Freight","/services"],["Sea Freight","/services"],["Road Freight","/services"],["Warehousing","/services"],["Last-Mile Delivery","/services"],["Customs Clearance","/services"]] },
        { title: "Company", links: [["About Us","/about"],["Contact","/contact"],["Careers","#"],["Privacy Policy","#"]] },
      ].map(({ title, links }, i) => (
        <div class="border border-white/10 rounded-xl overflow-hidden">
          <button class="footer-acc-btn w-full flex items-center justify-between px-4 py-3.5 text-white font-semibold text-sm" data-index={i}>
            {title}
            <svg class="h-4 w-4 text-gray-400 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="footer-acc-panel hidden px-4 pb-4">
            <ul class="space-y-2.5">
              {links.map(([label, href]) => (
                <li><a href={href} class="text-sm text-gray-400 hover:text-white transition-colors">{label}</a></li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Desktop grid -->
    <div class="hidden sm:grid grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="col-span-2 lg:col-span-1">
        <p class="text-gray-500 text-sm leading-relaxed">
          Connecting businesses across Bangladesh and beyond — one shipment at a time.
        </p>
        <div class="flex flex-wrap gap-2 mt-4">
          {["Trusted", "Transparent", "On-Time"].map(tag => (
            <span class="bg-white/5 border border-white/10 text-gray-400 text-xs px-3 py-1 rounded-full">{tag}</span>
          ))}
        </div>
      </div>
      <div>
        <p class="text-white font-semibold mb-4 text-sm">Services</p>
        <ul class="space-y-2.5 text-sm">
          {["Air Freight","Sea Freight","Road Freight","Warehousing","Last-Mile Delivery","Customs Clearance"].map(s => (
            <li><a href="/services" class="hover:text-white transition-colors">{s}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-white font-semibold mb-4 text-sm">Company</p>
        <ul class="space-y-2.5 text-sm">
          {[["About Us","/about"],["Contact","/contact"],["Careers","#"],["Privacy Policy","#"]].map(([label, href]) => (
            <li><a href={href} class="hover:text-white transition-colors">{label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-white font-semibold mb-4 text-sm">Support</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/track" class="hover:text-white transition-colors">Track Shipment</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Get a Quote</a></li>
          <li><a href="tel:+8801959395939" class="hover:text-white transition-colors">01959395939</a></li>
          <li><a href="mailto:info@tipu.com" class="hover:text-white transition-colors">info@tipu.com</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10 py-4 px-4">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-600">
      <span>&copy; {year} Tipu Logistics. All rights reserved.</span>
      <span class="flex items-center gap-1.5 text-green-500">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        All systems operational
      </span>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll('.footer-acc-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const panel = btn.nextElementSibling;
      const arrow = btn.querySelector('svg');
      const isOpen = !panel?.classList.contains('hidden');
      panel?.classList.toggle('hidden', isOpen);
      arrow?.classList.toggle('rotate-180', !isOpen);
    });
  });
</script>
